ErrorDocument 400 /error/400.php
ErrorDocument 401 /error/401.php
ErrorDocument 403 /error/403.php
ErrorDocument 404 /error/404.php
ErrorDocument 405 /error/405.php
ErrorDocument 408 /error/408.php
ErrorDocument 410 /error/410.php
ErrorDocument 500 /error/500.php
ErrorDocument 502 /error/502.php
ErrorDocument 503 /error/503.php
ErrorDocument 504 /error/504.php

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <IfModule mod_setenvif.c>
        SetEnvIf Cookie "insquire_lti_frame=1" INSQUIRE_LTI_FRAME
        Header always set X-Frame-Options "SAMEORIGIN" env=!INSQUIRE_LTI_FRAME
    </IfModule>
    <IfModule !mod_setenvif.c>
        Header always set X-Frame-Options "SAMEORIGIN"
    </IfModule>
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?insquire\.org(?::\d+)?$ [NC]
RewriteCond %{REQUEST_URI} !^/(?:api(?:/|$)|stripe-webhook\.php$) [NC]
RewriteRule ^ https://ed.insquire.org%{REQUEST_URI} [R=302,L,NE]
RewriteRule ^(?:index\.php)?$ app/index.html [L]
RewriteRule ^(login|register|dashboard|classes|notifications)\.php$ /$1 [R=302,L]
RewriteRule ^join-class\.php$ /classes [R=302,L]
RewriteRule ^(?:login|register|dashboard|classes|notifications)(?:/.*)?$ app/index.html [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^favicon\.ico$ - [L]

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

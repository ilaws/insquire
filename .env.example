# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Only the database settings are required; everything else is optional and the
# matching feature turns itself off (or shows a "not configured" notice) when blank.

# --- Database (required) -----------------------------------------------------
ESSAY_DB_HOST=db
ESSAY_DB_NAME=insquire
ESSAY_DB_USER=insquire
ESSAY_DB_PASS=change-me-local-only
MARIADB_ROOT_PASSWORD=change-me-root-local-only

# --- Site URLs ---------------------------------------------------------------
# The app decides Personal vs Education mode by hostname. Locally:
#   Personal -> http://localhost:8080     Education -> http://127.0.0.1:8080
ESSAY_PERSONAL_APP_URL=http://localhost:8080
ESSAY_EDUCATION_APP_URL=http://127.0.0.1:8080
# Show a "Visit InsQuire Personal" link on the Education site
ESSAY_SHOW_PERSONAL_LINK=1

# --- AI feedback (DeepSeek, OpenAI-compatible API) ---------------------------
ESSAY_DEEPSEEK_API_KEY=
ESSAY_DEEPSEEK_API_URL=https://api.deepseek.com
ESSAY_DEEPSEEK_FEEDBACK_MODEL=deepseek-flash
ESSAY_DEEPSEEK_TEACHER_MODEL=deepseek-flash
ESSAY_AI_RATE_LIMIT_PER_MINUTE=12
ESSAY_AI_RATE_LIMIT_PER_HOUR=100
ESSAY_AI_RATE_LIMIT_PER_DAY=10
ESSAY_AI_PERSONAL_FREE_DAILY_LIMIT=
ESSAY_AI_PERSONAL_PAID_DAILY_LIMIT=100
ESSAY_AI_EDUCATION_DAILY_LIMIT=100

# --- Google sign-in (optional; button is hidden when blank) ------------------
ESSAY_GOOGLE_OAUTH_CLIENT_ID=

# --- Stripe billing (optional; checkout shows "not configured" when blank) --
ESSAY_STRIPE_SECRET_KEY=
ESSAY_STRIPE_WEBHOOK_SECRET=
ESSAY_BILLING_METADATA_SECRET=
ESSAY_STRIPE_PERSONAL_MONTHLY_PRICE_ID=
ESSAY_STRIPE_EDU_PRICE_1_99=
ESSAY_STRIPE_EDU_PRICE_100_299=
ESSAY_STRIPE_EDU_PRICE_300_699=
ESSAY_STRIPE_EDU_PRICE_700_1299=
ESSAY_STRIPE_EDU_PRICE_1300_2199=
ESSAY_STRIPE_EDU_PRICE_2200_3199=
ESSAY_STRIPE_EDU_PRICE_3200_PLUS=
ESSAY_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# --- Canvas LMS / LTI 1.3 (optional) -----------------------------------------
ESSAY_LTI_ISSUER=
ESSAY_LTI_CLIENT_ID=
ESSAY_LTI_DEPLOYMENT_ID=
ESSAY_LTI_LOGIN_URL=
ESSAY_LTI_TOKEN_URL=
ESSAY_LTI_JWKS_URL=
ESSAY_LTI_KEY_ID=
# PEM with literal \n for newlines
ESSAY_LTI_PRIVATE_KEY=
ESSAY_CANVAS_API_BASE_URL=
ESSAY_CANVAS_OAUTH_CLIENT_ID=
ESSAY_CANVAS_OAUTH_CLIENT_SECRET=
ESSAY_CANVAS_OAUTH_REDIRECT_URI=

# --- Misc (optional) ---------------------------------------------------------
ESSAY_API_TOKEN_TTL=2592000
ESSAY_EDUCATION_DEFAULT_CLASS_ID=0
ESSAY_MESSAGE_MODERATION_TERMS=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX); blank = no analytics or cookie banner
ESSAY_GA_MEASUREMENT_ID=
ESSAY_ADSENSE_ENABLED=0
ESSAY_ADSENSE_PUBLISHER_CLIENT_ID=
ESSAY_ADSENSE_PERSONAL_FREE_SLOT_ID=
